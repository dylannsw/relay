{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "../package.json",
  "identifier": "com.relay.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "width": 1193,
        "height": 736,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "maximized": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/telegram/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwRTM2RUYzRkFBNTExQTkKUldTcEVhWDY4MjdqVVAwL2x5c3dSWFQraWt5ckhESmJJRjNjTzVNRW4xbWNXeU0yK25ONUJ5RkoK",
      "endpoints": [
        "https://github.com/dylannsw/relay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
